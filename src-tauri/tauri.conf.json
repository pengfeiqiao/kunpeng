{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist"
  },
  "package": {
    "productName": "鲲鹏",
    "version": "2.8.6"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "protocol": {
        "asset": true,
        "assetScope": [
          "$HOME/**",
          "$HOME/.kunpeng/**",
          "/tmp/**",
          "/private/tmp/**",
          "$DESKTOP/**"
        ]
      },
      "shell": {
        "all": false,
        "open": true,
        "execute": true,
        "scope": [
          {
            "name": "curl",
            "cmd": "curl",
            "args": true
          },
          {
            "name": "python3",
            "cmd": "python3",
            "args": true
          }
        ]
      },
      "http": {
        "all": true,
        "scope": [
          "https://**"
        ]
      },
      "fs": {
        "all": true,
        "scope": [
          "$HOME/**",
          "$HOME/.kunpeng/**",
          "/tmp/**",
          "/private/tmp/**"
        ]
      },
      "path": {
        "all": true
      },
      "dialog": {
        "all": true
      },
      "notification": {
        "all": true
      },
      "window": {
        "all": true
      }
    },
    "bundle": {
      "active": true,
      "targets": "dmg",
      "identifier": "ai.kunpeng.desktop",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "macOS": {
        "minimumSystemVersion": "10.13"
      },
      "resources": [
        "../skills/**/*",
        "../aigc-memory/**/*",
        "../scripts/render-worker.mjs",
        "../scripts/motion-runtime.js",
        "../dsh-runtime/**/*",
        "../.local-browsers/**/*"
      ]
    },
    "macOSPrivateApi": true,
    "systemTray": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true
    },
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; style-src-elem 'self' 'unsafe-inline' https://fonts.googleapis.com; style-src-attr 'unsafe-inline'; img-src 'self' asset: https://asset.localhost https: data: blob:; media-src 'self' asset: https://asset.localhost https: blob:; font-src 'self' data: https://fonts.gstatic.com https://fonts.googleapis.com; connect-src 'self' ipc: https://ipc.localhost https: wss:"
    },
    "windows": [
      {
        "label": "main",
        "fullscreen": false,
        "resizable": true,
        "title": "鲲鹏",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "fileDropEnabled": true
      },
      {
        "label": "float-ball",
        "url": "float-ball.html",
        "title": "",
        "width": 64,
        "height": 64,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "x": 1300,
        "y": 700,
        "fileDropEnabled": false
      }
    ]
  }
}
